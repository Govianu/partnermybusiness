# PAID setup for real launch (rename to render.yaml): Starter plan + 1 GB disk so data survives restarts.
# Email: paid Render allows SMTP (Zoho), or keep BREVO_API_KEY.
services:
  - type: web
    name: partnermybusiness
    runtime: node
    plan: starter
    region: singapore
    buildCommand: npm install
    startCommand: npm start
    healthCheckPath: /
    disk:
      name: pmb-data
      mountPath: /opt/render/project/src/data
      sizeGB: 1
    envVars:
      - key: NODE_ENV
        value: production
      - key: JWT_SECRET
        generateValue: true
      - key: ADMIN_INVITE_CODE
        sync: false
      - key: STAFF_EMAIL_DOMAINS
        value: govianu.com
      - key: APP_URL
        sync: false
      - key: SMTP_HOST
        value: smtppro.zoho.in
      - key: SMTP_PORT
        value: "465"
      - key: SMTP_USER
        value: info@partnermybusiness.ai
      - key: SMTP_PASS
        sync: false
      - key: MAIL_FROM
        value: Partnermybusiness.ai <info@partnermybusiness.ai>
      - key: TEAM_INBOX
        value: info@partnermybusiness.ai
      - key: HIGGSFIELD_API_KEY_ID
        sync: false
      - key: HIGGSFIELD_API_KEY_SECRET
        sync: false
      - key: HIGGSFIELD_MONTHLY_MINUTES
        value: "20"
