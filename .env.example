# ---------- Required ----------
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_INVITE_CODE=choose-a-private-team-code
PORT=3000
# The public address of the site. Used for links inside emails.
APP_URL=https://partnermybusiness.ai
# Local default for uploaded photos, videos and PDF slides. On Render, set this to a folder
# inside the persistent disk mount (for example /var/data/uploads).
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# ---------- Email (needed for enquiry, dashboard and booking emails) ----------
# Render Free blocks outbound SMTP on ports 25, 465 and 587. Use Brevo's HTTPS API there.
# The sender in MAIL_FROM must be verified in Brevo. If set, this API key takes precedence over SMTP.
BREVO_API_KEY=
# SMTP works locally and on hosts that allow outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@partnermybusiness.ai
SMTP_PASS=
MAIL_FROM=Partnermybusiness.ai <info@partnermybusiness.ai>
# Where every new enquiry is sent
TEAM_INBOX=info@partnermybusiness.ai

# ---------- Optional ----------
# AI-written opportunity cards for new businesses (templates are used without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Real Google Meet links when a business accepts a booking
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Razorpay Route split payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_INFRA_ACCOUNT=
RAZORPAY_LEADGEN_ACCOUNT=

# Set to production on the live server (hides test links, secures cookies)
NODE_ENV=production

# ---------- AI presenter videos for lessons (HeyGen, optional) ----------
# Each lesson video is made the first time someone opens it, saved on this server, and reused for
# everyone with the same business type and topic. Without these, lessons use the animated slides.
# 1. Create an API key at app.heygen.com (Settings > API) and add API credit (pay as you go).
# 2. Put the key below, then run `npm run heygen:list -- india` to see avatars and Indian English voices.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Free, watermarked test videos while you try it out. Set to false to make real videos.
HEYGEN_TEST_MODE=true
# Spending guard: most minutes of new video per calendar month (each lesson is about 1 minute)
HEYGEN_MONTHLY_MINUTES=60
# Optional look
HEYGEN_BACKGROUND=#F6F8FC
HEYGEN_VOICE_SPEED=1

# ---------- Email through the Brevo API (use this on Render's FREE plan, which blocks email ports) ----------
# Free Brevo plan: 300 emails a day. In Brevo: Settings > Senders > add info@partnermybusiness.ai and click the link
# Brevo emails you; then SMTP & API > API keys > generate a key. When BREVO_API_KEY is set, SMTP settings are ignored.
BREVO_API_KEY=
